erDiagram
    BranchConfiguration ||--o{ User : assigns
    BranchConfiguration ||--o{ Schedule : hosts
    BranchConfiguration ||--|| SystemConfiguration : configures
    User |o--o{ Schedule : staffs
    User |o--o{ Reservation : books
    User ||--o{ ChildProfile : has
    User ||--o{ AuditLog : performs
    Schedule ||--o{ Reservation : tickets
    ChildProfile |o--o{ Reservation : copied_onto

    BranchConfiguration {
        string id PK
        string name
        string clinicAddress
        string weeklyHours
    }

    User {
        string uid PK
        string name
        string email
        string phone
        string role
        string status
        string assignedBranch
        string assignedBranchId FK
        boolean onboardingComplete
        boolean isDeleted
    }

    ChildProfile {
        string childId PK
        string parentId FK
        string childName
        string age
        string sex
    }

    Schedule {
        string scheduleId PK
        string branchId FK
        string branch
        string doctorId FK
        string clinicDate
        string openingTime
        string closingTime
        int slotCapacity
        string status
        string queueStatus
    }

    Reservation {
        string reservationId PK
        string scheduleId FK
        string parentId FK
        string reservationCode
        int queueNumber
        int queueOrder
        string queueState
        string status
        string source
        string parentName
        string parentPhone
        string children
        string concern
        string doctorNotes
        int penaltyCount
        datetime penaltyTimerExpiresAt
        boolean checkedIn
    }

    SystemConfiguration {
        string branchId PK
        int penaltyMoveBack
        int penaltyGraceMinutes
        int penaltyTimerMinutes
        int nearingTurnAheadCount
        string smsTemplates
    }

    AuditLog {
        string logId PK
        string action
        string category
        string actorUid FK
        string actorRole
        string targetType
        string targetId
        datetime loggedAt
    }
