{
  "rules": {
    "users": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor')",
      ".indexOn": ["phone", "phoneNumber", "email"],
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor') && (root.child('users').child(auth.uid).child('status').val() === 'active' || (!root.child('users').child(auth.uid).child('status').exists() && newData.child('status').val() === 'active') || (auth.uid === $uid && root.child('users').child($uid).child('role').val() === 'parent' && root.child('users').child($uid).child('status').val() === 'inactive' && root.child('users').child($uid).child('isDeleted').val() !== true && newData.child('status').val() === 'active' && newData.child('isDeleted').val() !== true))"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'active' && (auth.uid === $uid || ((root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor') && (!root.child('users').child($uid).exists() || root.child('users').child($uid).child('role').val() !== 'parent')))"
      }
    },
    "smsOtps": {
      ".read": false,
      ".write": false
    },
    "phoneVerifications": {
      ".read": false,
      ".write": false
    },
    "passwordResetLimits": {
      ".read": false,
      ".write": false
    },
    "branchConfigurations": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor') && root.child('users').child(auth.uid).child('status').val() === 'active'"
    },
    "schedules": {
      ".read": "auth != null",
      ".indexOn": ["status"],
      "$scheduleId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'doctor' || root.child('users').child(auth.uid).child('role').val() === 'secretary') && root.child('users').child(auth.uid).child('status').val() === 'active' && (!newData.exists() || (newData.child('booking').child('activeSlotCount').val() == data.child('booking').child('activeSlotCount').val() && newData.child('booking').child('nextQueueNumber').val() == data.child('booking').child('nextQueueNumber').val()))"
      }
    },
    "clinicClosures": {
      ".read": "auth != null",
      "$closureId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'active' && (root.child('users').child(auth.uid).child('role').val() === 'doctor' || (root.child('users').child(auth.uid).child('role').val() === 'secretary' && ((newData.exists() && root.child('users').child(auth.uid).child('assignedBranchId').val() === newData.child('branchId').val()) || (!newData.exists() && root.child('users').child(auth.uid).child('assignedBranchId').val() === data.child('branchId').val()))))"
      }
    },
    "bookingLocks": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'doctor' || root.child('users').child(auth.uid).child('role').val() === 'secretary' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": false
      }
    },
    "reservations": {
      ".read": "auth != null",
      ".indexOn": ["scheduleId", "parentId", "reservationCode", "penaltyTimerExpiresAt"],
      "$reservationId": {
        ".write": "auth != null && data.exists() && root.child('users').child(auth.uid).child('status').val() === 'active' && (root.child('users').child(auth.uid).child('role').val() === 'parent' || root.child('users').child(auth.uid).child('role').val() === 'doctor' || root.child('users').child(auth.uid).child('role').val() === 'secretary')"
      }
    },
    "auditLogs": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor')",
      ".write": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'active' && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor' || root.child('users').child(auth.uid).child('role').val() === 'secretary')",
      ".indexOn": ["timestamp", "category", "actorRole"]
    },
    "systemConfiguration": {
      "queue": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor' || root.child('users').child(auth.uid).child('role').val() === 'secretary')",
        ".write": false
      },
      "sms": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor' || root.child('users').child(auth.uid).child('role').val() === 'secretary' || root.child('users').child(auth.uid).child('role').val() === 'parent')",
        ".write": false
      },
      "$branchId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor' || root.child('users').child(auth.uid).child('role').val() === 'parent' || (root.child('users').child(auth.uid).child('role').val() === 'secretary' && root.child('users').child(auth.uid).child('assignedBranchId').val() === $branchId))",
        ".write": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'active' && root.child('branchConfigurations').child($branchId).exists() && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor' || (root.child('users').child(auth.uid).child('role').val() === 'secretary' && root.child('users').child(auth.uid).child('assignedBranchId').val() === $branchId))",
        "sms": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor' || root.child('users').child(auth.uid).child('role').val() === 'parent' || (root.child('users').child(auth.uid).child('role').val() === 'secretary' && root.child('users').child(auth.uid).child('assignedBranchId').val() === $branchId))"
        }
      }
    }
  }
}
